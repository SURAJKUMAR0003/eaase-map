# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional Gemini AI features
GEMINI_API_KEY=

# Optional password reset delivery service. Receives POST JSON { to, subject, text }.
# Keep the bearer token server-side and use an HTTPS delivery endpoint.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=

# Optional isolated code runner. This must be a dedicated sandbox service that runs
# submitted code without network access, as a non-root user, with restricted filesystem,
# CPU/memory/process limits and cleanup. Never point this at an ordinary app server.
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=

PORT=3000
# Set NODE_ENV=production for production deployments.
